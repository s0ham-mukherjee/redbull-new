{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sakurascore.india/schemas/input.schema.v1.json",
  "title": "SakuraScore simulation input (schema v1.0)",
  "description": "Contract for the sakura-abm audience simulation subsystem. See docs/INTEGRATION_GUIDE.md. JSON Schema is provided for documentation/tooling; the authoritative validator is sakurascore_sim.models.validate_input.",
  "type": "object",
  "required": ["schema_version", "ip_id", "title", "audience_segments", "scenarios", "simulation"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "1.0"},
    "ip_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-_]{1,63}$"},
    "title": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1, "default": "experiment"},
    "media_type": {"type": "string", "default": "anime_film"},
    "genre": {"type": "string", "default": "unspecified"},
    "engine": {"type": "string", "enum": ["auto", "abm"], "default": "auto",
      "description": "'auto' selects the registered engine (sakura-abm). Other values are rejected with ENGINE_UNAVAILABLE until an OASIS adapter is added."},
    "evidence_file": {"type": "string",
      "description": "Path to a curated evidence dataset JSON (relative paths resolve against the config file directory)."},
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/definitions/evidenceItem"}
    },
    "notes": {"type": "string"},
    "audience_segments": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/definitions/audienceSegment"}
    },
    "scenarios": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/definitions/scenario"}
    },
    "simulation": {
      "type": "object",
      "properties": {
        "agent_count": {"type": "integer", "minimum": 2, "maximum": 5000, "default": 20},
        "rounds": {"type": "integer", "minimum": 1, "maximum": 100, "default": 5},
        "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647, "default": 42},
        "seeds": {"type": "array", "items": {"type": "integer"}, "maxItems": 25,
          "description": "Variability ensemble; headline run uses 'seed'."},
        "variability": {"type": "boolean", "default": false,
          "description": "If true and 'seeds' absent, generates 5 seeds from 'seed'."},
        "network_degree": {"type": "integer", "minimum": 1, "maximum": 20, "default": 3},
        "word_of_mouth_boost": {"type": "number", "minimum": 0, "maximum": 3, "default": 0.8},
        "announcement_boost": {"type": "number", "minimum": 0, "maximum": 10, "default": 2.0},
        "dub_lift": {"type": "number", "minimum": 1, "maximum": 3, "default": 1.6},
        "discovery_cap": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.95}
      }
    }
  },
  "definitions": {
    "evidenceItem": {
      "type": "object",
      "required": ["id", "title", "url", "publisher", "date", "finding", "type", "region", "label", "quality"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
        "title": {"type": "string"},
        "url": {"type": "string", "pattern": "^https?://"},
        "publisher": {"type": "string"},
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"},
        "finding": {"type": "string", "minLength": 1,
          "description": "The specific fact this source supports, in one or two sentences."},
        "type": {"type": "string", "examples": ["market_report", "news", "box_office", "survey", "community", "official"]},
        "region": {"type": "string"},
        "label": {"enum": ["observed", "inferred"]},
        "quality": {"enum": ["high", "medium", "low"]},
        "tags": {"type": "array", "items": {"type": "string"}},
        "source_id": {"type": "string", "description": "Reference into src/sakurascore_sim/research/source_registry.py"},
        "retrieved_via": {"type": "string"},
        "retrieved_at": {"type": "string"}
      }
    },
    "audienceSegment": {
      "type": "object",
      "required": ["id", "label", "size_share", "base_interest", "discovery_base",
                   "view_info_prob", "share_prob", "discuss_prob",
                   "language_affinity", "channel_affinity"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-_]{0,63}$"},
        "label": {"type": "string"},
        "size_share": {"type": "number", "exclusiveMinimum": 0, "maximum": 1,
          "description": "Share of the agent population; all segments must sum to 1.0 (tolerance 0.01)."},
        "base_interest": {"type": "number", "minimum": 0, "maximum": 1},
        "discovery_base": {"type": "number", "minimum": 0, "maximum": 1},
        "view_info_prob": {"type": "number", "minimum": 0, "maximum": 1},
        "share_prob": {"type": "number", "minimum": 0, "maximum": 1},
        "discuss_prob": {"type": "number", "minimum": 0, "maximum": 1},
        "language_affinity": {"type": "object", "minProperties": 1,
          "propertyNames": {"enum": ["ja", "en", "hi", "ta", "te", "mr", "bn", "kn", "ml"]},
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
        "channel_affinity": {"type": "object", "minProperties": 1,
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
        "evidence_ids": {"type": "array", "items": {"type": "string"},
          "description": "Must reference ids present in the merged evidence set."},
        "notes": {"type": "string"},
        "hypothesis_label": {"type": "string", "default": "modelling hypothesis"}
      }
    },
    "scenario": {
      "type": "object",
      "required": ["id", "label", "languages_available", "marketing_reach"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-_]{0,63}$"},
        "label": {"type": "string"},
        "is_baseline": {"type": "boolean", "default": false,
          "description": "Marks the comparison baseline. If omitted, the FIRST scenario in the list is the baseline."},
        "counterfactual": {"type": "boolean", "default": false,
          "description": "True if this scenario did NOT occur and is constructed for comparison."},
        "description": {"type": "string"},
        "languages_available": {"type": "array", "minItems": 1,
          "items": {"enum": ["ja", "en", "hi", "ta", "te", "mr", "bn", "kn", "ml"]}},
        "marketing_reach": {"type": "object", "minProperties": 1,
          "additionalProperties": {"type": "number", "minimum": 0}}
      }
    }
  }
}
