{
  "framework": null,
  "functions": {
    "api/v1/[[...route]].ts": {
      "runtime": "@vercel/node@5.10.2",
      "includeFiles": "{configs/**,data/**,src/**}",
      "maxDuration": 60
    },
    "api/py/index.py": {
      "includeFiles": "api/_backend/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/pipeline/:path*",
      "destination": "/api/py/index?__path=/api/v1/pipeline/:path*"
    },
    {
      "source": "/api/v1/greenlight/presets",
      "destination": "/api/py/index?__path=/api/v1/greenlight/presets"
    },
    {
      "source": "/api/v1/greenlight",
      "destination": "/api/py/index?__path=/api/v1/greenlight"
    },
    {
      "source": "/api/v1/voice-cast",
      "destination": "/api/py/index?__path=/api/v1/voice-cast"
    },
    {
      "source": "/api/v1/sketch-check",
      "destination": "/api/py/index?__path=/api/v1/sketch-check"
    }
  ]
}